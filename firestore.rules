rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidScore(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'score', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'score', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score <= 9007199254740991
        && request.resource.data.updatedAt == request.time;
    }

    match /playerProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'playerData', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'playerData', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.playerData is map
        && request.resource.data.playerData.keys().hasOnly([
          'prodigal_blaster_high_score_v1',
          'prodigal_blaster_muted_v1',
          'prodigal_blaster_hermes_wings_v1',
          'prodigal_blaster_meta_v1',
          'prodigal_blaster_legend_powers_v1'
        ])
        && request.resource.data.playerData.keys().hasAll([
          'prodigal_blaster_high_score_v1',
          'prodigal_blaster_muted_v1',
          'prodigal_blaster_hermes_wings_v1',
          'prodigal_blaster_meta_v1',
          'prodigal_blaster_legend_powers_v1'
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Running game leaderboard (unchanged behaviour)
    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if isValidScore(uid);
      allow update: if isValidScore(uid)
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }

    // Prodigal Blaster leaderboard (separate from the running game)
    match /blasterLeaderboard/{uid} {
      allow read: if true;
      allow create: if isValidScore(uid);
      allow update: if isValidScore(uid)
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;
    }
  }
}
