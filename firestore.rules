rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if isValidScore(uid);
      allow update: if isValidScore(uid)
        && request.resource.data.score >= resource.data.score;
      allow delete: if false;

      function isValidScore(userId) {
        return request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'displayName', 'score', 'updatedAt'])
          && request.resource.data.keys().hasAll(['uid', 'displayName', 'score', 'updatedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 40
          && request.resource.data.score is int
          && request.resource.data.score > 0
          && request.resource.data.score <= 9007199254740991
          && request.resource.data.updatedAt == request.time;
      }
    }
  }
}
